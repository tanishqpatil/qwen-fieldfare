{
  "$schema": "https://opencode.ai/config.json",
  "model": "fieldfare/qwen-fieldfare",
  "small_model": "fieldfare/qwen-fieldfare",
  "provider": {
    "fieldfare": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "QwenFieldfare",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "{env:QWENFIELDFARE_API_KEY}",
        "timeout": 600000
      },
      "models": {
        "qwen-fieldfare": {
          "name": "QwenFieldfare local",
          "limit": {
            "context": 8192,
            "output": 1024
          },
          "tool_call": true,
          "temperature": true
        }
      }
    }
  },
  "agent": {
    "fieldfare": {
      "description": "Disposable local qualification",
      "mode": "primary",
      "prompt": "You are a careful coding assistant. Use enabled tools one at a time. Read calculator.py directly; do not list directories or use ls. Work only in the current disposable Git workspace using its canonical absolute paths. Follow the requested edit and test sequence. Never inspect outside it. Do not ask questions or delegate.",
      "temperature": 0,
      "steps": 16,
      "permission": {
        "*": "deny",
        "read": "allow",
        "grep": "allow",
        "edit": "ask",
        "bash": "ask",
        "external_directory": "deny"
      }
    }
  },
  "autoupdate": false,
  "share": "disabled"
}
